# Copy this file to ".env" (start.bat does it for you the first time) and fill it in.

# ---- SMS -------------------------------------------------------------
# test            = messages are recorded in the app but NOT sent (safe for trying things out)
# africastalking  = send real SMS through Africa's Talking
SMS_PROVIDER=test

# From your Africa's Talking account (https://account.africastalking.com)
# For the free sandbox, use AT_USERNAME=sandbox and the sandbox API key.
AT_USERNAME=sandbox
AT_API_KEY=
# Your approved sender ID, e.g. BCI_CHURCH. Leave empty to use Africa's Talking's shared sender.
AT_SENDER_ID=
# live or sandbox
AT_ENVIRONMENT=sandbox

# ---- Server ----------------------------------------------------------
# 127.0.0.1 = only this computer can open the app
# 0.0.0.0   = other computers on the office network can open it too
HOST=127.0.0.1
PORT=5000

# Where the database is kept. Relative paths are inside this folder.
# Tip: keep it OUTSIDE OneDrive/Google Drive sync folders, e.g. C:/BCI_data
DATA_DIR=data

# Leave empty and the app creates a random one in the data folder.
SECRET_KEY=
